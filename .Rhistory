# Format hatchery release covariate
# Covariate final form: Asian pink salmon hatchery releases
# source: NPAFC https://www.npafc.org/statistics/ - Data download 1-8-2024
# two hatchery covariates created here
# one is pink salmon from the north pacfiic and the second is chum from asian continent and AK
library(tidyverse)
library(here)
library(readxl)
library(zoo)
# (From G Ruggerone in Oct 2025, 9-2025)
# Competition Index  B - Wild + Hatchery Chum salmon abundance in annual year. I lagged by two years and then there is a rolling mean.
abund <- read_csv("data/pink_chum_salmon_total_abundances.csv") %>%
filter(!year <2000) %>%
dplyr::mutate(chum_nat_hatch = as.numeric(chum),
pink_nat_hatch = as.numeric(pinks),
year = as.numeric(year)) %>%
dplyr::select(year, chum_nat_hatch,pink_nat_hatch) %>%
dplyr::mutate(brood_year = year-2) %>%
dplyr::select(-year)
View(abund)
# non-scaled for Fig S1
not_scaled_save <- abund %>%
dplyr::mutate(id = "N Pacific",
rolling_avg_pink_nat_hatch = zoo::rollmean(pink_nat_hatch,
k = 3,
align = "right",
partial = TRUE,
na.pad = TRUE),
rolling_avg_chum_nat_hatch = zoo::rollmean(chum_nat_hatch,
k = 3,
align = "right",
partial = TRUE,
na.pad = TRUE)) %>%
dplyr::select(3,5:6) %>%
filter(!is.na(rolling_avg_pink_nat_hatch)) %>%
dplyr::arrange(brood_year)
# non-scaled for Fig S1
not_scaled_save <- abund %>%
dplyr::mutate(id = "N Pacific",
rolling_avg_pink_nat_hatch = zoo::rollmean(pink_nat_hatch,
k = 3,
align = "right",
partial = TRUE,
na.pad = TRUE),
rolling_avg_chum_nat_hatch = zoo::rollmean(chum_nat_hatch,
k = 3,
align = "right",
partial = TRUE,
na.pad = TRUE)) %>%
dplyr::select(3,5:6) %>%
filter(!is.na(rolling_avg_pink_nat_hatch)) %>%
dplyr::arrange(brood_year)
write_csv(not_scaled_save, "data/Pink_Chum_Cov_Notscaled.csv")
