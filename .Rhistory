# Competition Index  B - Wild + Hatchery Chum salmon abundance
abund <- read_csv("data/pink_chum_salmon_total_abundances.csv") %>%
filter(!year <2000) %>%
dplyr::mutate(chum = as.numeric(scale(chum))) %>%
dplyr::select(year, chum)
write_csv(abund, "output/total_chum_CovB.csv")
ggplot(data = abund) +
geom_line(aes(x=year, y = chum))
